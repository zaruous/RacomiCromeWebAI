{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "icons": {
    "16": "assets/logo-16.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo-128.png"
  },
  "commands": {
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Left",
        "mac": "Command+Shift+Left"
      },
      "description": "Open side panel"
    },
    "input_selected_text": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Input selected text to prompt"
    }
  },
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "declarativeNetRequest",
    "scripting",
    "system.cpu",
    "system.memory",
    "commands"
  ],
  "background": {
    "service_worker": "scripts/Background/background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://localhost:11434/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "panel.html",
    "openPanelOnActionClick": true
  },
  "action": {
    "default_title": "Click to open panel"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/WebUI/selection.js"
      ],
      "run_at": "document_end",
      "type": "module"
    },
    {
      "matches": [
        "https://www.google.com/*"
      ],
      "js": [
        "lib/marked.min.js",
        "lib/prism.js",
        "scripts/WebUI/googleResultsComponent.js"
      ],
      "run_at": "document_end",
      "css": [
        "output.css",
        "css/prism.css",
        "css/light.css"
      ],
      "type": "module"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "lib/marked.min.js",
        "scripts/WebUI/emailComponent.js"
      ],
      "run_at": "document_end",
      "css": [
        "output.css",
        "css/prism.css",
        "css/light.css"
      ],
      "type": "module"
    }
  ]
}
